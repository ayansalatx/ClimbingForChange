{
  "scripts": {
    "install:client": "npm install --prefix pumppro-client",
    "install:server": "npm install --prefix pumppro-server",
    "client": "npm run dev --prefix client",
    "server": "npm run dev   --prefix server",
    "dev": "concurrently \"npm:server\" \"npm:client\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "cpr": "^3.0.1",
    "rimraf": "^6.0.1"
  }
}
