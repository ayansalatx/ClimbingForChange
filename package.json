{
  "scripts": {
    "install:client": "npm install --prefix client",
    "install:server": "npm install --prefix server",
    "clean": "rimraf client/public && rimraf server/public",
    "build:client": "npm run build --prefix client",
    "copy:client-to-server": "cpr client/public server/public -f",
    "build:integrated": "npm install && npm run clean && npm run install:client && npm run build:client && npm run copy:client-to-server && npm run install:server",
    "lint:client": "npm run lint --prefix client",
    "lint:server": "npm run lint --prefix server",
    "lint": "npm run lint:server",
    "client": "npm run dev --prefix client",
    "server": "npm run dev   --prefix server",
    "dev": "concurrently \"npm:server\" \"npm:client\"",
    "test": "npm run test --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "cpr": "^3.0.1",
    "rimraf": "^6.0.1"
  }
}